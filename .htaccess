# ГАЛАРС — настройки веб-сервера.
#
# Если сразу после заливки сайт отдаёт «500 Internal Server Error» —
# значит хостинг не разрешает какую-то из строк ниже. Удалить этот файл,
# сайт заработает, и написать разработчику.

# --- Адреса старого сайта --------------------------------------------
# Старый сайт жил на путях без .html: /about, /galvan, /contacts и так
# далее. Они в индексе поисковиков с 2016 года и в чужих ссылках. Без
# перенаправления каждый такой переход упёрся бы в «страница не найдена»,
# и накопленные позиции обнулились бы.
# Снято с архива старого сайта от 25.11.2026 (его sitemap.xml).
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www → основной адрес. Было и на старом сайте, но вело на http;
  # теперь сразу на https.
  RewriteCond %{HTTP_HOST} ^www\.galars\.ru$ [NC]
  RewriteRule ^(.*)$ https://galars.ru/$1 [R=301,L]

  # О компании
  RewriteRule ^about/?$                /about.html      [R=301,L]
  RewriteRule ^about/price/?$          /#contact        [R=301,L]
  RewriteRule ^about/zakaz/?$          /#how            [R=301,L]

  # Гальваника и всё, что под ней
  RewriteRule ^galvan/?$               /coatings/       [R=301,L]
  RewriteRule ^galvan/gost/?$          /faq.html        [R=301,L]
  RewriteRule ^galvan/oborud/?$        /about.html      [R=301,L]
  RewriteRule ^galvan/federal/?$       /about.html      [R=301,L]
  RewriteRule ^galvan/ohrana/?$        /about.html      [R=301,L]
  RewriteRule ^galvan/licenz(/.*)?$    /about.html      [R=301,L]
  RewriteRule ^galvan/.*$              /coatings/       [R=301,L]

  # Контакты и вакансии
  RewriteRule ^contacts/?$             /#contact        [R=301,L]
  RewriteRule ^vacancy/?$              /vacancies.html  [R=301,L]

  # Фотографии производства — теперь лента работ на главной
  RewriteRule ^photo(/.*)?$            /#works          [R=301,L]

  # Новостей, выставок и гостевой книги на новом сайте нет
  RewriteRule ^news(/.*)?$             /                [R=301,L]
  RewriteRule ^vystavki/?$             /                [R=301,L]
  RewriteRule ^book/?$                 /                [R=301,L]
</IfModule>

# --- Кодировка -------------------------------------------------------
# Подтверждено в панели nic.ru: сайт настроен на Windows-1251, сервер
# подставляет её всем страницам. Новый сайт в UTF-8, поэтому кодировку
# переключают и в панели (Настройки → Веб-сервер), и здесь — страховка
# на случай, если настройку панели кто-нибудь вернёт обратно.
AddDefaultCharset UTF-8

# --- Главная страница ------------------------------------------------
DirectoryIndex index.html index.php

# --- Своя страница «не найдено» --------------------------------------
ErrorDocument 404 /404.html

# --- Не показывать содержимое папок ----------------------------------
Options -Indexes

# --- Сжатие ----------------------------------------------------------
# 3D-сцена и шрифты весят заметно; сжатие срезает их в несколько раз.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json image/svg+xml
</IfModule>

# --- Кэш в браузере --------------------------------------------------
# Картинки и шрифты меняются редко, страницы — каждый раз заново,
# иначе клиент поправит текст через админку и не увидит изменений.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg              "access plus 1 month"
  ExpiresByType image/png               "access plus 1 month"
  ExpiresByType image/webp              "access plus 1 month"
  ExpiresByType image/svg+xml           "access plus 1 month"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType application/font-woff2  "access plus 1 year"
  ExpiresByType text/css                "access plus 7 days"
  ExpiresByType application/javascript  "access plus 7 days"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

# --- Витрина на запасном адресе -------------------------------------
# Пока сайт показывают на galars.me (или любом другом адресе, кроме
# боевого), он закрыт от поисковиков: иначе Яндекс и Google проиндексируют
# копию и засчитают её дублем — боевому galars.ru от этого только хуже.
# На самом galars.ru заголовок не ставится, индексация идёт как обычно.
<IfModule mod_setenvif.c>
  SetEnvIf Host ".*" NOINDEX=1
  SetEnvIf Host "^(www\.)?galars\.ru(:[0-9]+)?$" !NOINDEX
</IfModule>
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow" env=NOINDEX
</IfModule>
